EXPO_PUBLIC_USE_EMULATOR=1
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
# On a phone, set this to the PC's LAN address, e.g. http://192.168.1.20:5055
EXPO_PUBLIC_FN_URL=http://127.0.0.1:5055
